# NeoBreed-ERP environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local. The service role key must NEVER reach the browser.

# Supabase — populated in Phase 2 (see docs/PHASE_PLAN.md).

# Public values (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Used by server actions / route handlers only.
SUPABASE_SERVICE_ROLE_KEY=
