# NeoBreed-ERP environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local. The service role key must NEVER reach the browser.

# Supabase — populated in Phase 2 (see docs/PHASE_PLAN.md).

# Public values (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Used by server actions / route handlers only.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL — used to build absolute redirect links for invite e-mails.
# Local dev: http://localhost:3000  |  Vercel preview/prod: full https URL.
# Must also be listed in Supabase Dashboard → Auth → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
